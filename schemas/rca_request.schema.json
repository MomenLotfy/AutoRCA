{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autorca.local/schemas/rca_request.schema.json",
  "title": "RCARequest",
  "description": "Final deterministic payload sent to the LLM.",
  "type": "object",
  "required": [
    "schema_version", "analysis_id", "repository_context",
    "selected_hypothesis", "confidence", "supporting_evidence",
    "contradicting_evidence", "excluded_hypotheses", "diff_excerpt",
    "log_excerpt", "generation_options"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "analysis_id": { "type": "string", "pattern": "^AR[0-9]{8}-[0-9]{3,}$" },
    "repository_context": {
      "type": "object",
      "required": ["full_name", "branch", "commit_sha", "environment"],
      "additionalProperties": false,
      "properties": {
        "full_name": { "type": "string" },
        "branch": { "type": "string" },
        "commit_sha": { "type": "string" },
        "environment": { "type": "string", "enum": ["local", "staging", "production"] }
      }
    },
    "selected_hypothesis": {
      "type": "object",
      "required": ["id", "failure_type_id", "label", "description", "score", "resolved_severity"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^RC[0-9]+$" },
        "failure_type_id": { "type": "string", "pattern": "^FT[0-9]+$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "resolved_severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"]
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "supporting_evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence_summary" }
    },
    "contradicting_evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence_summary" }
    },
    "excluded_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "score", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RC[0-9]+$" },
          "label": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "type": "string", "enum": ["rejected", "low_confidence"] }
        }
      }
    },
    "diff_excerpt": { "type": "string" },
    "log_excerpt": { "type": "string" },
    "generation_options": {
      "type": "object",
      "required": ["include_pr_diff", "include_incident_report", "include_fix_steps"],
      "additionalProperties": false,
      "properties": {
        "include_pr_diff": { "type": "boolean" },
        "include_incident_report": { "type": "boolean" },
        "include_fix_steps": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "evidence_summary": {
      "type": "object",
      "required": ["evidence_id", "failure_type_id", "summary", "raw_reference"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^E[0-9]+$" },
        "failure_type_id": { "type": "string", "pattern": "^FT[0-9]+$" },
        "summary": { "type": "string" },
        "raw_reference": { "type": ["string", "null"] }
      }
    }
  }
}
