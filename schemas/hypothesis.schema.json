{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autorca.local/schemas/hypothesis.schema.json",
  "title": "Hypothesis",
  "description": "Candidate root cause, scored deterministically by RuleEngine.",
  "type": "object",
  "required": [
    "id", "analysis_id", "schema_version", "failure_type_id",
    "label", "description", "links", "score", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^RC[0-9]+$" },
    "analysis_id": { "type": "string", "pattern": "^AR[0-9]{8}-[0-9]{3,}$" },
    "schema_version": { "type": "integer", "const": 1 },
    "failure_type_id": { "type": "string", "pattern": "^FT[0-9]+$" },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "relation"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^E[0-9]+$" },
          "relation": { "type": "string", "enum": ["supports", "contradicts"] }
        }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": {
      "type": "string",
      "enum": ["candidate", "selected", "rejected", "low_confidence"]
    }
  }
}
